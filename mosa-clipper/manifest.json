{
  "manifest_version": 3,
  "name": "Mosa Web Clipper",
  "version": "1.2.0",
  "description": "Lưu ảnh gốc độ phân giải cao từ Pinterest, Behance, ArchDaily và mọi trang web vào Mosa Moodboard chỉ với 1 click (không lỗi CORS).",
  "icons": {
    "16": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mosa Web Clipper",
    "default_icon": {
      "16": "icons/icon-128.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:4313/*",
    "http://localhost:4313/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["destinations.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
